<Window x:Class="DolaCoordinator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DolaCoordinator.Views"
        mc:Ignorable="d"
        Title="ALL IN ONE MMO PRO — Dola Coordinator"
        Icon="Assets/logo64.ico"
        Height="900" Width="1440" MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="NavSection" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="22,18,0,6"/>
        </Style>
        <Style x:Key="NavIcon" TargetType="Image">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,10">
                    <Image Source="Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ALL IN ONE MMO" FontSize="14.5" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Text="Dola Coordinator" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer sidebar -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,10,16,18">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding SettingsVm.CurrentVersion}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0">
                        <Run Text="Reset quota: "/><Run Text="{Binding NextResetTimeString, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Thẻ cảnh báo: chưa cài môi trường chạy (nằm ngay trên chân thanh bên) -->
                <Border DockPanel.Dock="Bottom" Margin="14,0,12,6" Padding="12,10" CornerRadius="8"
                        Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSetupCard}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding SetupTitle}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SetupDetail}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <Button Content="{Binding SetupButtonText}" Command="{Binding RunSetupCommand}" Style="{StaticResource ModernPrimaryButton}" Height="30" FontSize="12"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Foreground="{StaticResource WarningBrush}" Background="{StaticResource WindowBackgroundBrush}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstallingEnvironment}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="{Binding SetupProgressText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <StackPanel>
                    <TextBlock Text="HỆ THỐNG" Style="{StaticResource NavSection}"/>
                    <RadioButton GroupName="Nav" Style="{StaticResource SidebarItem}"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/Icons/settings.png" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Cài đặt"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="ĐIỀU PHỐI" Style="{StaticResource NavSection}"/>
                    <RadioButton GroupName="Nav" Style="{StaticResource SidebarItem}"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/Icons/robot.png" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Quản lý tài khoản"/>
                            <Border Margin="10,0,0,0" CornerRadius="9" Padding="7,1,7,2" Background="{StaticResource InfoSoftBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding ProfilesVm.TotalCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding ProfilesVm.TotalCount}"/>
                            </Border>
                            <Border Margin="6,0,0,0" CornerRadius="9" Padding="7,1,7,2" Background="{StaticResource SuccessSoftBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding ProfilesVm.RunningCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                           Text="{Binding ProfilesVm.RunningCount, StringFormat='{}{0} mở'}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav" Style="{StaticResource SidebarItem}"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/Icons/clapperboard.png" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Quản lý prompt"/>
                            <Border Margin="10,0,0,0" CornerRadius="9" Padding="7,1,7,2" Background="{StaticResource InfoSoftBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding PromptsVm.TotalCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding PromptsVm.TotalCount}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav" Style="{StaticResource SidebarItem}"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/Icons/dashboard.png" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Vận hành"/>
                            <Border Margin="10,0,0,0" CornerRadius="9" Padding="7,1,7,2" Background="{StaticResource InfoSoftBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding QueueVm.ActiveCount, Converter={StaticResource CountToVisibilityConverter}}"
                                    ToolTip="Số video đang chờ / đang chạy">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding QueueVm.ActiveCount}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PageSubtitle}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="16" Padding="14,6" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGatewayOnline}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGatewayOnline}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding GatewayStatusBadge}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Pages -->
            <Grid Grid.Row="1">
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                    <views:QueueView DataContext="{Binding QueueVm}"/>
                </Grid>
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                    <views:ProfilesView DataContext="{Binding ProfilesVm}"/>
                </Grid>
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}">
                    <views:SettingsView DataContext="{Binding SettingsVm}"/>
                </Grid>
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=3}">
                    <views:PromptsView DataContext="{Binding PromptsVm}"/>
                </Grid>
            </Grid>

            <!-- Tiến độ tổng của đợt đang chạy (hiện ở mọi trang; 100% = xong toàn bộ) -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="24,10" Visibility="{Binding QueueVm.BatchCount, Converter={StaticResource CountToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TIẾN ĐỘ TỔNG" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <ProgressBar Value="{Binding QueueVm.OverallPercent, Mode=OneWay}" Maximum="100" Height="20" BorderThickness="0"
                                     Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding QueueVm.OverallPercent, StringFormat='{}{0:0}%'}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding QueueVm.OverallText}" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
