<UserControl x:Class="DolaCoordinator.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:DolaCoordinator.Models"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="{DynamicResource ModernFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="GlyphText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KpiNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- Badge trạng thái gộp (đăng nhập + phiên + hạn ngạch) -->
        <Style x:Key="StateBadge" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.Ready}">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.LoggedIn}">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.Validating}">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.Rendering}">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.Invalid}">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Text" Value="{Binding StatusText}"/>
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.Ready}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.LoggedIn}">
                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.Validating}">
                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.Rendering}">
                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:ProfileState.Invalid}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chấm trạng thái trình duyệt -->
        <Style x:Key="RunDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RunText" TargetType="TextBlock">
            <Setter Property="Text" Value="Đã đóng"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Text" Value="Đang mở"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Text" Value="Đang xử lý…"/>
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nút Mở/Đóng trong bảng -->
        <Style x:Key="OpenButton" TargetType="Button" BasedOn="{StaticResource ModernPrimaryButton}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Content" Value="Mở"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Content" Value="Đóng"/>
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Menu Nhập / Xuất -->
        <ContextMenu x:Key="IoMenu">
            <MenuItem Header="Nhập tài khoản từ Excel / CSV…" Command="{Binding ImportFromFileCommand}"/>
            <MenuItem Header="Tải file mẫu Excel (đủ các loại tài khoản)…" Command="{Binding DownloadTemplateCommand}"/>
            <MenuItem Header="Đồng bộ lại từ gateway (accounts/)" Command="{Binding SyncFromGatewayCommand}"/>
            <MenuItem Header="Mở thư mục accounts của gateway" Command="{Binding OpenProfilesRootCommand}"/>
            <Separator/>
            <MenuItem Header="Xuất danh sách (đã chọn hoặc đang hiển thị)…" Command="{Binding ExportToFileCommand}"/>
        </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Mỗi dòng là một tài khoản Dola = một profile Chromium của gateway (accounts/&lt;tên&gt;). Đăng nhập một lần (thủ công / Google / Facebook) — phiên được lưu vào cookie.txt, gateway dùng lại khi render."/>
            <Button Grid.Column="1" Style="{StaticResource ModernPrimaryButton}" Command="{Binding AddProfileCommand}"
                    Padding="18,9" VerticalAlignment="Top" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE710;" Margin="0,0,8,0"/>
                    <TextBlock Text="Thêm tài khoản"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Cảnh báo thiếu gateway -->
        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14,10" CornerRadius="8"
                Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ProblemText}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- KPI -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource ModernCard}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Icons/kpi-users.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG TÀI KHOẢN" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource KpiNumber}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Icons/kpi-logged-in.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SẴN SÀNG" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ReadyCount}" Style="{StaticResource KpiNumber}" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Icons/synchronize.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HẾT HẠN NGẠCH" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ExhaustedCount}" Style="{StaticResource KpiNumber}" Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ModernCard}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Icons/kpi-login-failed.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CẦN ĐĂNG NHẬP / LỖI" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding NeedLoginCount}" Style="{StaticResource KpiNumber}" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Toolbar -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="12,10,12,4" Margin="0,0,0,14">
            <WrapPanel>
                <Grid Width="220" Margin="0,0,8,6">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm theo tên hoặc ghi chú"/>
                    <TextBlock Text="Tìm tài khoản…" IsHitTestVisible="False" Foreground="{StaticResource TextMutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox Width="150" ItemsSource="{Binding StatusFilters}" SelectedIndex="{Binding StatusFilterIndex}" Margin="0,0,20,6"/>

                <Button Content="Mở đã chọn" Command="{Binding OpenSelectedCommand}" Margin="0,0,8,6"
                        ToolTip="Mở trình duyệt cho các tài khoản đã tích"/>
                <Button Content="Đóng đã chọn" Command="{Binding CloseSelectedCommand}" Margin="0,0,8,6"/>
                <Button Content="Đăng nhập tự động" Command="{Binding AutoLoginSelectedCommand}" Margin="0,0,8,6"
                        ToolTip="Đăng nhập Google / Facebook / cookie Facebook cho các tài khoản đã tích, dùng thông tin đã ghi nhớ (chưa có thì hỏi một lần)"/>
                <Button Content="Sửa" Command="{Binding EditSelectedCommand}" Margin="0,0,8,6"
                        ToolTip="Sửa tài khoản đã tích (tích đúng 1 dòng): cách đăng nhập, tài khoản/mật khẩu đã lưu, ghi chú"/>
                <Button Content="Kiểm tra phiên" Command="{Binding ValidateSelectedCommand}" Margin="0,0,8,6"
                        ToolTip="Nhờ gateway kiểm tra đăng nhập thật (các dòng đã tích, hoặc tất cả nếu chưa tích)"/>
                <Button Content="Đưa vào vận hành" Command="{Binding IncludeSelectedCommand}" Margin="0,0,8,6"
                        ToolTip="Các tài khoản đã tích sẽ được dùng khi chạy ở trang Vận hành"/>
                <Button Content="Loại khỏi vận hành" Command="{Binding ExcludeSelectedCommand}" Margin="0,0,8,6"
                        ToolTip="Các tài khoản đã tích sẽ không được dùng khi chạy (vẫn giữ nguyên đăng nhập)"/>
                <Button Content="Reset hạn ngạch" Command="{Binding ResetQuotaSelectedCommand}" Margin="0,0,8,6"/>
                <Button Content="Mở thư mục" Command="{Binding OpenFolderSelectedCommand}" Margin="0,0,8,6"
                        ToolTip="Mở thư mục accounts/&lt;tên&gt; của các tài khoản đã tích (chưa tích thì mở thư mục accounts)"/>
                <Button Content="Nhập / Xuất / Gateway ▾" Click="IoMenu_Click" Margin="0,0,8,6"/>
                <Button Content="Xóa đã chọn" Command="{Binding DeleteSelectedCommand}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6"/>
            </WrapPanel>
        </Border>

        <!-- Bảng tài khoản -->
        <Border Grid.Row="4" Style="{StaticResource ModernCard}" Padding="0" Margin="0,0,0,14">
            <Grid>
                <DataGrid ItemsSource="{Binding View}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="46">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                          HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TÀI KHOẢN" Width="*" MinWidth="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding SubText}" ToolTip="{Binding SubText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="DÙNG ĐỂ CHẠY" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding UseForRender, Mode=TwoWay}" IsEnabled="{Binding HasSession}"
                                              Click="UseForRender_Click"
                                              ToolTip="Tích = tài khoản này được dùng khi chạy ở trang Vận hành (mặc định đã tích). Bỏ tích để loại khỏi vận hành. Cần đăng nhập trước."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StateBadge}" ToolTip="{Binding StatusDetail}">
                                        <TextBlock Style="{StaticResource StateBadgeText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TRÌNH DUYỆT" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource RunDot}"/>
                                        <TextBlock Style="{StaticResource RunText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="HẠN NGẠCH" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding QuotaText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                               ToolTip="Đã dùng / giới hạn hôm nay"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="CREDIT" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreditText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="KIỂM TRA CUỐI" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastValidatedAt, Converter={StaticResource UtcToLocalTextConverter}}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource OpenButton}"
                                            Command="{Binding DataContext.ToggleProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Trạng thái rỗng -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Image Source="/Assets/Icons/gender-neutral-user.png" Width="48" Height="48" Opacity="0.7" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Chưa có tài khoản nào" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Thêm tài khoản, đăng nhập một lần rồi dùng lại mãi." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <Button Content="Thêm tài khoản đầu tiên" Style="{StaticResource ModernPrimaryButton}" Command="{Binding AddProfileCommand}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Padding="18,9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nhật ký -->
        <Border Grid.Row="5" Style="{StaticResource ModernCard}" Height="140" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Xóa nhật ký" Command="{Binding ClearLogCommand}"/>
                    <TextBlock Text="NHẬT KÝ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox Grid.Row="1" Text="{Binding LogOutput, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         Padding="0" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" TextChanged="Log_TextChanged"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
