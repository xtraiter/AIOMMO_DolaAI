<UserControl x:Class="DolaCoordinator.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850"
             FontFamily="{DynamicResource ModernFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="CÀI ĐẶT HỆ THỐNG &amp; KẾT NỐI GATEWAY" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

            <!-- Card 1: Gateway Connection -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Dola Render Gateway API" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="Địa chỉ Gateway Server URL:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding GatewayUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        <Button Grid.Column="1" Content="🔌 Kiểm Tra Kết Nối" Command="{Binding TestConnectionCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="10,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnectionOk}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Gateway Client API Key (Nếu có cấu hình DOLA_API_KEYS):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ClientApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,6" />
                    <TextBlock Text="* Để trống nếu Gateway đang chạy ở chế độ dev/anonymous." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,12" />
                    <CheckBox IsChecked="{Binding AutoStartGateway}" Content="Bật sẵn gateway (chạy ngầm) ngay khi mở phần mềm — nếu tắt, gateway vẫn tự chạy ngầm khi bạn dùng điều phối / kiểm tra phiên" />
                </StackPanel>
            </Border>

            <!-- Card 2: Quota & Concurrency -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="2. Hạn Ngạch &amp; Theo Dõi Tiến Trình" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số video tối đa mỗi tài khoản mỗi ngày (theo chính sách Dola hiện tại):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="Áp dụng ngay cho mọi tài khoản khi bấm Lưu. Reset 00:00 mỗi ngày; Dola báo hết lượt sớm hơn thì tài khoản tự khóa tới ngày mai." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding DefaultDailyQuota}" Style="{StaticResource ModernTextBox}" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chu kỳ Polling kiểm tra tiến trình (giây):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="Khoảng thời gian giữa các lần gọi GET /v1/videos/{id} để theo dõi tiến độ." Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding PollingIntervalSeconds}" Style="{StaticResource ModernTextBox}" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

                        <!-- Card 3: Gateway & Profile -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="3. Gateway &amp; Profile trình duyệt" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="Thư mục dola-render-gateway (để trống = tự dò):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding GatewayDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        <Button Grid.Column="1" Content="Chọn thư mục…" Command="{Binding BrowseGatewayDirCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding GatewayDirDetectedText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <TextBlock Text="Lệnh Python chạy script gateway (mặc định: py -3; chỉ dùng khi chạy gateway từ mã nguồn, bản có dola-gateway.exe không cần):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PythonCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" />

                    <TextBlock Text="Admin Key (DOLA_ADMIN_KEY của gateway, để trống nếu gateway không đặt):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding AdminKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,6" />
                    <TextBlock Text="* Mỗi tài khoản là thư mục accounts/&lt;tên&gt; của gateway, mở bằng Chromium của patchright (ja-JP, giờ Tokyo, proxy DOLA_PROXY chung) — đúng như lúc gateway render. Cần Admin Key để đọc trạng thái, kiểm tra và xóa tài khoản qua gateway." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Card 3b: Trình duyệt Chromium -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Trình duyệt Chromium của gateway" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding BrowserStatusText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="⬇ Cài đặt trình duyệt" Command="{Binding InstallBrowserCommand}" Style="{StaticResource ModernSecondaryButton}" HorizontalAlignment="Left" Height="34" Padding="18,0" />
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource WindowBackgroundBrush}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstallingBrowser}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Text="{Binding BrowserProgressText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="* App tự cài ở lần dùng đầu tiên; dùng nút này khi lần tự cài bị lỗi (mạng, proxy, tường lửa). Nếu Playwright tải không được, app sẽ tải gói dự phòng từ GitHub." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Card: Sao lưu / khôi phục toàn bộ -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Sao lưu &amp; khôi phục toàn bộ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="Xuất tất cả tài khoản (kèm đăng nhập, cookie, phiên, proxy đã gán), proxy, prompt và kịch bản lớn ra một file Excel; khôi phục lại trên máy khác. Khôi phục chỉ THÊM, không xóa dữ liệu đang có."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Sao lưu toàn bộ" Command="{Binding BackupAllCommand}" Style="{StaticResource ModernPrimaryButton}" Padding="16,9" Margin="0,0,8,0"/>
                        <Button Content="Khôi phục toàn bộ" Command="{Binding RestoreAllCommand}" Padding="16,9"/>
                    </StackPanel>
                    <TextBlock Text="⚠ File sao lưu chứa mật khẩu và cookie ở dạng văn bản thường — giữ ở nơi an toàn, xóa khi không cần."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BackupStatusText}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Storage & Notification -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="4. Thông Báo &amp; Thử Lại" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="Thư mục lưu video chọn ngay trên trang Tạo video." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding EnableToastNotification}" Content="Hiển thị Windows Toast Notification khi hoàn tất toàn bộ hàng đợi" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                    <CheckBox IsChecked="{Binding AutoRetryOnFailure}" Content="Tự động thử lại tác vụ với Exponential Backoff khi gặp lỗi gián đoạn mạng" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 4: Auto Update & Version -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="5. Cập Nhật Phần Mềm &amp; Phiên Bản" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Phiên bản hiện tại: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding CurrentVersion}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,12,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄 Kiểm Tra Cập Nhật Ngay" Command="{Binding CheckForUpdateCommand}" Style="{StaticResource ModernSecondaryButton}" />
                    </Grid>

                    <TextBlock Text="URL kiểm tra cập nhật (HTTPS, file version.json). Để trống = tắt tự cập nhật:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding UpdateCheckUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" />

                    <!-- Status Text -->
                    <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <!-- If update available panel -->
                    <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAvailableUpdate}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Nội dung cập nhật mới (Changelog):" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding AvailableUpdate.Changelog}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ProgressBar Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="14" Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding UpdateDownloadProgress, StringFormat='{}Đang tải: {0}%'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <Button Content="⚡ TẢI VÀ CẬP NHẬT NGAY" Command="{Binding DownloadAndApplyUpdateCommand}" Style="{StaticResource ModernPrimaryButton}" Height="34" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Khi Dola hỏi lại -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Khi Dola hỏi lại thay vì tạo video" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />
                    <CheckBox IsChecked="{Binding AutoAnswerAskBack}" Content="Tự trả lời Dola để nó tạo video luôn (tối đa 3 lần mỗi video)" Margin="0,0,0,10" />
                    <TextBlock Text="Câu app gõ vào khung chat khi Dola hỏi (ví dụ 'dùng 15 giây được không?', 'bạn có ảnh khuôn mặt không, A hay B?'):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding AskBackReply, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="80" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Style="{StaticResource ModernTextBox}" />
                    <Button Content="Đặt lại nội dung mặc định" Command="{Binding ResetAskBackReplyCommand}" Style="{StaticResource ModernSecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,6" />
                    <TextBlock Text="* Prompt của bạn được gửi nguyên văn, app không chèn thêm gì. Dola hay hỏi lại khi kịch bản dài hơn mức nó hỗ trợ (hiện 4–15 giây) hoặc thiếu ảnh khuôn mặt; app phát hiện câu hỏi (khoảng 12 giây sau khi Dola viết xong), gõ câu trả lời trên và Dola sẽ tạo video. Nếu sau 3 lần vẫn hỏi, tác vụ báo lỗi kèm câu hỏi của Dola. Nhật ký và cột 'Thực tế' cho biết Dola cuối cùng tạo dài bao nhiêu giây." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Save Action Button -->
            <Button Content="💾 LƯU CẤU HÌNH HỆ THỐNG" Command="{Binding SaveSettingsCommand}" Style="{StaticResource ModernPrimaryButton}" Height="38" FontSize="14" HorizontalAlignment="Left" Width="240" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
