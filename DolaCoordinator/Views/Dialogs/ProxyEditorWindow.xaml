<Window x:Class="DolaCoordinator.Views.Dialogs.ProxyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SidebarBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="26,22,26,22">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap"
                   Text="Tài khoản nào được gán proxy này sẽ mở Chromium qua nó (đăng nhập, kiểm tra phiên, tạo video)."/>

        <TextBlock Text="TÊN GỢI NHỚ" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" MaxLength="60" Margin="0,0,0,12" ToolTip="Để trống thì lấy host:port"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="KIỂU" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="SchemeBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="HOST / IP" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="HostBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="PORT" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PortBox"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="TÀI KHOẢN PROXY (nếu có)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UserBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="PasswordLabel" Text="MẬT KHẨU PROXY" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="GHI CHÚ" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NoteBox" Margin="0,0,0,8"/>

        <TextBlock x:Name="HintText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy" Width="90" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Style="{StaticResource ModernPrimaryButton}" MinWidth="120" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
