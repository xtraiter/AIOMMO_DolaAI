<Window x:Class="DolaCoordinator.Views.Dialogs.ScriptProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DolaCoordinator.Views.Dialogs"
        Width="820" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SidebarBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,22">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="Dán một kịch bản dài, tách thành các phần (mỗi phần một video). App chạy lần lượt: video phần trước xong thì lấy khung hình cuối làm ảnh mở đầu cho phần sau, cùng nhân vật và bối cảnh, rồi ghép thành một video."/>

            <TextBlock Text="TÊN KỊCH BẢN" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ProjectTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding ModelLabel}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="TỶ LỆ" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding RatioOptions}" SelectedItem="{Binding Ratio}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="THỜI LƯỢNG MỖI PHẦN (giây)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding Duration}"
                              ToolTip="Độ dài của MỖI video (phần). 30 giây chỉ có ở Seedance 2.5."/>
                </StackPanel>
            </Grid>

            <!-- nhân vật + bối cảnh dùng chung cho mọi phần -->
            <local:CastEditor x:Name="CastBox" DataContext="{Binding Cast}" Margin="0,0,0,14"/>

            <TextBlock Text="KỊCH BẢN ĐẦY ĐỦ (dán vào đây rồi bấm Tách)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding FullScript, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="170" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="13"/>
            <WrapPanel Margin="0,8,0,14">
                <TextBlock Text="Tách theo" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Width="250" SelectedIndex="{Binding SplitModeIndex}" Margin="0,0,14,6">
                    <ComboBoxItem Content="Từng 'Cảnh N' / 'Phần N' / 'Scene N'"/>
                    <ComboBoxItem Content="Đoạn cách nhau dòng trống hoặc dòng ---"/>
                </ComboBox>
                <TextBlock Text="Gom" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Width="48" Text="{Binding BlocksPerPartText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6" TextAlignment="Center"/>
                <TextBlock Text="khối (cảnh / đoạn) thành một phần" VerticalAlignment="Center" Margin="0,0,14,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="Tách thành các phần" Click="Split_Click" Style="{StaticResource ModernPrimaryButton}" Margin="0,0,0,6"/>
            </WrapPanel>

            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="➕ Thêm phần" Click="AddPart_Click"/>
                <TextBlock Text="CÁC PHẦN (mỗi phần = một video, chạy theo thứ tự)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                    <Button Content="▲" Tag="{Binding}" Click="MoveUp_Click" Style="{StaticResource GhostButton}" ToolTip="Dời lên"/>
                                    <Button Content="▼" Tag="{Binding}" Click="MoveDown_Click" Style="{StaticResource GhostButton}" ToolTip="Dời xuống" Margin="0,2,0,2"/>
                                    <Button Content="Xóa" Tag="{Binding}" Click="RemovePart_Click" Style="{StaticResource GhostButton}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Number, StringFormat='Phần {0}'}" FontWeight="SemiBold" Margin="0,0,0,4"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="92" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12.5"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox Content="Lấy khung hình cuối của video trước làm ảnh mở đầu cho video sau (nối liền cảnh)" IsChecked="{Binding UseLastFrame}" Margin="0,10,0,6"/>
            <CheckBox Content="Tự ghép thành một video khi mọi phần đã xong" IsChecked="{Binding AutoMerge}" Margin="0,0,0,10"/>

            <Expander Header="Câu dặn AI về phần nối tiếp (mặc định đã đủ dùng, sửa nếu muốn)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="GẮN VÀO ĐẦU CÁC PHẦN TỪ PHẦN 2 ({n} = số phần, {total} = tổng số phần)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ContinueHeader, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    <TextBlock Text="GẮN VÀO CUỐI CÁC PHẦN TRỪ PHẦN CUỐI (báo còn phần phía sau, khung hình cuối phải chuẩn)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding ContinueFooter, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    <Button Content="Đặt lại hai câu mặc định" Click="ResetHints_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Expander>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Hủy" Width="90" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Style="{StaticResource ModernPrimaryButton}" MinWidth="140" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
