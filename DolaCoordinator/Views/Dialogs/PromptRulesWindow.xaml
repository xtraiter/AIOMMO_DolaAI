<Window x:Class="DolaCoordinator.Views.Dialogs.PromptRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt quy tắc" Width="720" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SidebarBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="26,22,26,22">
        <TextBlock Text="Prompt quy tắc" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock x:Name="SourceText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>

        <TextBox x:Name="RulesBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13"
                 Height="380" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

        <DockPanel Margin="0,14,0,0">
            <Button Content="Đóng" Width="90" DockPanel.Dock="Right" IsCancel="True" Click="Close_Click" Margin="10,0,0,0"/>
            <Button Content="Chép prompt quy tắc" DockPanel.Dock="Right" Style="{StaticResource ModernPrimaryButton}" Click="Copy_Click" Padding="18,8"/>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </StackPanel>
</Window>
