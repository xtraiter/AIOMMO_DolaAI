<UserControl x:Class="DolaCoordinator.Views.Dialogs.LoginOptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = LoginOptions -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="ĐĂNG NHẬP" Style="{StaticResource FieldLabel}"/>
        <WrapPanel Margin="0,0,0,12">
            <RadioButton Content="Thủ công" Margin="0,0,18,6"
                         IsChecked="{Binding Method, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Manual}"/>
            <RadioButton Content="Google (tài khoản + mật khẩu)" Margin="0,0,18,6"
                         IsChecked="{Binding Method, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Google}"/>
            <RadioButton Content="Facebook (tài khoản + mật khẩu)" Margin="0,0,18,6"
                         IsChecked="{Binding Method, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Facebook}"/>
            <RadioButton Content="Facebook (cookie)" Margin="0,0,0,6"
                         IsChecked="{Binding Method, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FacebookCookie}"/>
        </WrapPanel>

        <!-- Google / Facebook: tài khoản + mật khẩu + khóa 2FA -->
        <StackPanel Visibility="{Binding Method, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Google|Facebook}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="EMAIL / SỐ ĐIỆN THOẠI" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="MẬT KHẨU" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="Password_Changed"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="KHÓA 2FA (TOTP, tùy chọn — để trống thì bạn tự nhập mã)" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TotpBox" PasswordChanged="Totp_Changed" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Facebook cookie -->
        <StackPanel Visibility="{Binding Method, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=FacebookCookie}">
            <TextBlock Text="COOKIE FACEBOOK (chứa c_user=... và/hoặc xs=...)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Cookie, UpdateSourceTrigger=PropertyChanged}" Height="56" TextWrapping="Wrap" AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,6"/>
            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Các bước: nạp cookie → mở Facebook xác nhận đã đăng nhập → chuyển sang Dola, chọn 'Tiếp tục với Facebook' → lưu phiên Dola vào profile (giống fb_to_dola.py)."/>
        </StackPanel>

        <!-- Sau khi đăng nhập xong -->
        <StackPanel Visibility="{Binding Method, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Manual|Google|Facebook|FacebookCookie}">
            <TextBlock Text="KHI ĐĂNG NHẬP XONG" Style="{StaticResource FieldLabel}"/>
            <WrapPanel Margin="0,0,0,6">
                <RadioButton Content="Giữ profile mở (chờ)" Margin="0,0,18,6"
                             IsChecked="{Binding After, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Keep}"/>
                <RadioButton Content="Tự đóng profile" Margin="0,0,0,6"
                             IsChecked="{Binding After, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Close}"/>
            </WrapPanel>
        </StackPanel>

        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap"
                   Visibility="{Binding Method, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Google|Facebook|FacebookCookie}"
                   Text="Captcha, 2FA (khi không nhập khóa TOTP), checkpoint hoặc sai mật khẩu: cửa sổ trình duyệt sẽ dừng chờ và dòng tài khoản hiện 'Cần bạn xử lý' — bạn tự giải, script tự chạy tiếp. Mật khẩu/khóa 2FA/cookie chỉ dùng trong bộ nhớ, không lưu lại."/>
    </StackPanel>
</UserControl>
