<Window x:Class="DolaCoordinator.Views.Dialogs.AddToQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SidebarBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Thêm vào hàng đợi" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="SummaryText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ModelBox" SelectedIndex="0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                <TextBlock Text="TỶ LỆ VIDEO" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="RatioBox" SelectedIndex="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                <TextBlock Text="THỜI LƯỢNG (giây)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DurationBox" SelectedIndex="0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="SỐ VIDEO MỖI PROMPT" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CopiesBox" Text="1" ToolTip="Tạo nhiều video từ cùng một prompt (1–20)"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="ĐỘ ƯU TIÊN" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="PriorityBox" SelectedIndex="0">
                    <ComboBoxItem Content="Thường"/>
                    <ComboBoxItem Content="Cao (chạy trước)"/>
                    <ComboBoxItem Content="Khẩn (chạy đầu tiên)"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3">
            <CheckBox x:Name="GoBox" IsChecked="True" Content="Chuyển sang trang Tạo video sau khi thêm" Margin="0,4,0,0"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hủy" Width="90" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Thêm vào hàng đợi" Style="{StaticResource ModernPrimaryButton}" MinWidth="160" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
