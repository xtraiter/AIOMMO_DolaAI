<Window x:Class="DolaCoordinator.Views.Dialogs.AutoLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:DolaCoordinator.Views.Dialogs"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SidebarBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Mở profile này và đăng nhập Dola. Cửa sổ trình duyệt sẽ hiện ra; captcha/2FA bạn tự giải, app tự chạy tiếp."/>
        </StackPanel>

        <Border Grid.Row="1" Padding="14" CornerRadius="8"
                Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <dlg:LoginOptionsPanel DataContext="{Binding Options}"/>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Width="90" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Bắt đầu" Style="{StaticResource ModernPrimaryButton}" MinWidth="130" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
