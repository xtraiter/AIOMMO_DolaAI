<Window x:Class="DolaCoordinator.Views.Dialogs.TextPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="560" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SidebarBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
        <TextBox x:Name="Body" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Đóng" Width="90" DockPanel.Dock="Right" IsCancel="True" Click="Close_Click" Margin="10,0,0,0"/>
            <Button Content="Chép" DockPanel.Dock="Right" Click="Copy_Click" Style="{StaticResource ModernPrimaryButton}" Padding="18,8"/>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
