<UserControl x:Class="DolaCoordinator.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:DolaCoordinator.Models"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="{DynamicResource ModernFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DolaModule.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="KpiNumber" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- Chấm + chữ trạng thái điều phối -->
            <Style x:Key="RunDot" TargetType="Ellipse">
                <Setter Property="Width" Value="9"/>
                <Setter Property="Height" Value="9"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsQueueRunning}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Badge độ ưu tiên -->
            <Style x:Key="PriorityText" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Priority}" Value="1">
                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PriorityText}" Value="Khẩn">
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Header + KPI -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Theo dõi và điều khiển các video đang làm. Prompt được soạn ở trang Quản lý prompt — chọn prompt rồi bấm 'Thêm vào hàng đợi'. Tích ô đầu dòng để dừng, thử lại hoặc đổi độ ưu tiên."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Ellipse Style="{StaticResource RunDot}"/>
                <TextBlock Text="{Binding RunStateText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource ModernCard}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Icons/film-reel.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ĐANG CHỜ" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding PendingCount}" Style="{StaticResource KpiNumber}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Icons/synchronize.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ĐANG CHẠY" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ProcessingCount}" Style="{StaticResource KpiNumber}" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ModernCard}" Margin="4,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Icons/kpi-logged-in.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HOÀN TẤT" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource KpiNumber}" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ModernCard}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Icons/kpi-login-failed.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LỖI" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource KpiNumber}" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Toolbar -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="12,10,12,4" Margin="0,0,0,14">
            <StackPanel>
                <WrapPanel>
                    <Button Command="{Binding TogglePrimaryCommand}" Content="{Binding PrimaryButtonText}" Style="{StaticResource ModernPrimaryButton}"
                            MinWidth="130" Margin="0,0,8,6" ToolTip="Bắt đầu điều phối / Tạm dừng (không nhận việc mới, video đang làm chạy nốt) / Tiếp tục"/>
                    <Button Content="⏹ Dừng tất cả" Command="{Binding StopAllCommand}" Foreground="{StaticResource DangerBrush}" Margin="0,0,20,6"
                            ToolTip="Dừng hẳn và HỦY cả các video đang làm dở"/>

                    <Grid Width="200" Margin="0,0,8,6">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm theo tên prompt, nội dung hoặc tài khoản"/>
                        <TextBlock Text="Tìm tác vụ…" IsHitTestVisible="False" Foreground="{StaticResource TextMutedBrush}" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Width="130" ItemsSource="{Binding StatusFilters}" SelectedIndex="{Binding StatusFilterIndex}" Margin="0,0,20,6"/>

                    <Button Content="Dừng tác vụ" Command="{Binding CancelSelectedCommand}" Margin="0,0,8,6" ToolTip="Dừng các tác vụ đã tích (đang chờ hoặc đang chạy)"/>
                    <Button Content="Thử lại" Command="{Binding RetrySelectedCommand}" Margin="0,0,8,6" ToolTip="Điều phối lại các tác vụ đã tích (lỗi / đã hủy / đã xong)"/>
                    <Button Content="⤒ Lên đầu" Command="{Binding PrioritizeTopCommand}" Margin="0,0,8,6" ToolTip="Đưa lên đầu hàng đợi: chạy trước mọi tác vụ đang chờ"/>
                    <Button Content="▲ Tăng ưu tiên" Command="{Binding RaisePriorityCommand}" Margin="0,0,8,6"/>
                    <Button Content="▼ Giảm ưu tiên" Command="{Binding LowerPriorityCommand}" Margin="0,0,20,6"/>

                    <Button Content="Xem video" Command="{Binding PlaySelectedCommand}" Margin="0,0,8,6"/>
                    <Button Content="Mở thư mục" Command="{Binding ShowInFolderCommand}" Margin="0,0,20,6" ToolTip="Mở thư mục chứa video của dòng đã tích (hoặc thư mục lưu video)"/>

                    <Button Content="Dọn đã xong" Command="{Binding ClearCompletedCommand}" Margin="0,0,8,6"/>
                    <Button Content="Dọn lỗi" Command="{Binding ClearFailedCommand}" Margin="0,0,8,6"/>
                    <Button Content="Xóa đã chọn" Command="{Binding DeleteSelectedCommand}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6"/>
                </WrapPanel>

                <!-- Cơ chế chạy -->
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,10"/>
                <WrapPanel Margin="0,0,0,2">
                    <StackPanel Margin="0,0,18,8">
                        <TextBlock Text="CƠ CHẾ CHẠY TÀI KHOẢN" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="400" ItemsSource="{Binding StrategyOptions}" SelectedIndex="{Binding StrategyIndex}"
                                  ToolTip="Chia đều: mỗi tài khoản một video, hết vòng mới quay lại tài khoản đầu. Hết từng tài khoản: dồn video vào tài khoản đầu cho tới khi hết lượt hoặc lỗi. Tài khoản lỗi luôn được bỏ qua."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,8">
                        <TextBlock Text="SỐ LUỒNG TỐI ĐA" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="90" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Text="{Binding MaxThreads, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Số video chạy cùng lúc (1–30). Mỗi luồng mở một cửa sổ Chromium nên máy yếu hãy để số nhỏ. Đổi là có hiệu lực ngay."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="TRÌNH DUYỆT KHI CHẠY" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel>
                            <CheckBox Content="Ẩn Chromium (chạy nền)" IsChecked="{Binding HideWindow}" Margin="0,7,18,0"
                                      ToolTip="Tích: cửa sổ Chromium nằm ngoài màn hình, không hiện lên. Bỏ tích: hiện cửa sổ để theo dõi. Trang Quản lý tài khoản (đăng nhập) luôn hiện."/>
                            <CheckBox Content="Bỏ qua tài khoản lỗi" IsChecked="{Binding SkipFailed}" Margin="0,7,0,0"
                                      ToolTip="Tài khoản vừa lỗi được bỏ qua ở các video khác trong 15 phút thay vì lần nào cũng thử lại"/>
                        </WrapPanel>
                    </StackPanel>
                </WrapPanel>

                <!-- Thư mục lưu video -->
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LƯU VIDEO VÀO" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SaveDirectory, UpdateSourceTrigger=LostFocus}" ToolTip="Video tải xong được lưu vào thư mục này (mặc định: thư mục Videos)"/>
                    <Button Grid.Column="2" Content="Chọn thư mục…" Command="{Binding BrowseSaveDirectoryCommand}" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bảng tác vụ -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="0" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="46">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="PROMPT" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4,0" ToolTip="{Binding Prompt}">
                                    <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayPrompt}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ƯU TIÊN" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PriorityText}" Style="{StaticResource PriorityText}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="MODEL" Binding="{Binding ModelLabel}" Width="105"/>
                    <DataGridTextColumn Header="TỈ LỆ" Binding="{Binding Ratio}" Width="65"/>
                    <DataGridTextColumn Header="THỜI LƯỢNG" Binding="{Binding Duration, StringFormat='{}{0}s'}" Width="95"/>
                    <DataGridTextColumn Header="ẢNH" Binding="{Binding ReferenceSummary}" Width="65"/>
                    <DataGridTextColumn Header="TÀI KHOẢN" Binding="{Binding AssignedSessionName}" Width="120"/>

                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RenderTaskStatus.Completed}">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RenderTaskStatus.Processing}">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RenderTaskStatus.Downloading}">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RenderTaskStatus.Failed}">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RenderTaskStatus.Pending}">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RenderTaskStatus.Cancelled}">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StageText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ErrorMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StageText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ErrorShort}" FontSize="10.5" Foreground="{StaticResource DangerBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ErrorMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RenderTaskStatus.Failed}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TIẾN ĐỘ" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="14" BorderThickness="0" Background="#1E293B" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Nhật ký -->
        <Border Grid.Row="4" Style="{StaticResource ModernCard}" Padding="14,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Xóa nhật ký" Command="{Binding ClearLogsCommand}"/>
                    <TextBlock Text="NHẬT KÝ ĐIỀU PHỐI" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox Text="{Binding LogOutput, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" TextChanged="LogBox_TextChanged"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
